{
  // Types for the CARTRIDGE build only. `tsconfig.json` stays `noEmit` because it is what the
  // typecheck gate runs, and a gate that writes files is a gate with a side effect.
  //
  // ⚠️ `rewriteRelativeImportExtensions` IS LOAD-BEARING. This codebase imports `./foo.ts` — which
  // `allowImportingTsExtensions` permits and a consumer cannot resolve. Without the rewrite the
  // emitted declarations would point at `.ts` files that are not published, and the failure lands on
  // whoever installs the package rather than on anyone who can see it here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist-lib",
    "rootDir": "app/js"
  },
  // The shell is not part of the cartridge: it is the standalone page's composition root, and
  // publishing its types would invite a consumer to call it.
  "include": ["app/js"],
  "exclude": ["app/js/boot"]
}
